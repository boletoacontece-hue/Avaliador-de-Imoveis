{
  "appId": "br.com.acontece.avaliador",
  "appName": "Avaliador Acontece",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#1B3A1B"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2500,
      "launchAutoHide": false,
      "backgroundColor": "#1B3A1B",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    },
    "StatusBar": {
      "backgroundColor": "#1B3A1B",
      "style": "DARK",
      "overlaysWebView": false
    }
  }
}
